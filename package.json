{
  "name": "sideproj",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --preserve-symlinks --preserve-symlinks-main server.mjs",
    "build": "node --preserve-symlinks --preserve-symlinks-main build.mjs",
    "preview": "node --preserve-symlinks --preserve-symlinks-main server.mjs --preview",
    "test": "node --preserve-symlinks --preserve-symlinks-main --test tests/server.test.mjs tests/guide-changes.test.mjs tests/supabase-auth.test.mjs tests/storage.test.mjs tests/media-limits.test.mjs tests/request-limits.test.mjs tests/navigation.test.mjs tests/session-store.test.mjs",
    "test:e2e": "node --preserve-symlinks --preserve-symlinks-main node_modules/@playwright/test/cli.js test",
    "test:e2e:open": "node --preserve-symlinks --preserve-symlinks-main node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:headed": "node --preserve-symlinks --preserve-symlinks-main node_modules/@playwright/test/cli.js test --headed",
    "test:e2e:debug": "node --preserve-symlinks --preserve-symlinks-main node_modules/@playwright/test/cli.js test --debug",
    "test:e2e:report": "node --preserve-symlinks --preserve-symlinks-main node_modules/@playwright/test/cli.js show-report",
    "test:dashboard": "node --preserve-symlinks --preserve-symlinks-main test-dashboard/server.mjs",
    "test:e2e:install": "node --preserve-symlinks --preserve-symlinks-main node_modules/@playwright/test/cli.js install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ffmpeg-static": "5.3.0",
    "monaco-editor": "0.56.0",
    "prettier": "3.6.2",
    "supabase": "2.121.0",
    "vite": "^6.4.3"
  }
}
